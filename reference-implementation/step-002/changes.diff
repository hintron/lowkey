 package lowkey
 
+import "base:runtime"
 import "core:fmt"
 
 main :: proc() {
 	fmt.println("Hello, world, from the Lowkey compiler!")
 }
+
+////////////////////////////////////////////////////////////////////////////////
+// Tokenization
+////////////////////////////////////////////////////////////////////////////////
+
+tokenize :: proc(source_text: string, allocator: runtime.Allocator) -> [dynamic]u8 {
+	output := make([dynamic]u8, allocator)
+	next_position := 0
+
+	// A simple state machine to indicate if we are tokenizing a word or not as
+	// we loop through characters.
+	currently_tokenizing := false
+
+	// Loop through each byte
+	for next_position < len(source_text) {
+		current_position := next_position
+		next_position += 1
+
+		character := source_text[current_position]
+
+		// Skip all whitespace
+		if character == ' ' || character == '\t' || character == '\n' {
+			currently_tokenizing = false
+			continue
+		}
+
+		// Anything other than whitespace is a word! (for now)
+		if !currently_tokenizing {
+			// Append byte position of new word to output
+			append(&output, u8(current_position))
+			currently_tokenizing = true
+		}
+	}
+	return output
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// Tests
+////////////////////////////////////////////////////////////////////////////////
+// odin test . -debug -define:ODIN_TEST_SHORT_LOGS=true -define:ODIN_TEST_THREADS=1
+
+import "core:testing"
+
+@(test)
+test_tokenize :: proc(t: ^testing.T) {
+	source_text := "This   is my program\n"
+	output := tokenize(source_text, context.temp_allocator)
+	testing.expect_value(t, output[0], 0)
+	testing.expect_value(t, output[1], 7)
+	testing.expect_value(t, output[2], 10)
+	testing.expect_value(t, output[3], 13)
+}
